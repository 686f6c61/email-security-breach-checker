# Email Security Breach Checker Configuration
# Copy this file to .env and fill in your actual API keys

# Have I Been Pwned API Configuration
# Get your API key from: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=your_hibp_api_key_here

# HIBP Subscription Tier (Pwned 1, Pwned 2, Pwned 3, Pwned 4, Pwned 5)
# Default: Pwned 1 (10 RPM, 25 domains/month, $4.50)
# See: https://haveibeenpwned.com/Subscription
HIBP_TIER=Pwned 1

# Resend Email Service Configuration  
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Sender Email Configuration
# This must be a verified domain in your Resend account
SENDER_EMAIL=your_email@yourdomain.com

# Optional: Recipient Email (for enterprise mode)
# If set, all reports will be sent to this email automatically
# If not set, user will be prompted for recipient each time
ENTERPRISE_RECIPIENT_EMAIL=admin@yourcompany.com

# Optional: Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Optional: Cache TTL in hours (default: 24)
CACHE_TTL_HOURS=24

# Optional: Request timeout in seconds (default: 10)
REQUEST_TIMEOUT=10

# Docker/Enterprise Settings
DOCKER_ENV=false
BATCH_SIZE=50

# Daily Execution Settings
DAILY_EXECUTION_TIME=02:00
DEFAULT_CSV_FILE=data/deposito/emails_ejemplo.csv
AUTO_EXPORT_FORMATS=csv excel
AUTO_SEND_REPORT=true

# Email Configuration
EMAIL_LANGUAGE=es
SEND_EMAIL_ONLY_WITH_BREACHES=true